{
  "name": "@augeron/core",
  "version": "0.1.0",
  "private": true,
  "description": "Augeron domain engine: DocumentTree, View-Specs, analyzers, and Oberon command tokenizer. Pure TypeScript, no DOM or Node I/O.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:pbt": "vitest run tests/invariants.prop.test.ts",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "fast-check": "^4.10.3",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ]
}
